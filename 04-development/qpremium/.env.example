DJANGO_SECRET_KEY=change-me-to-long-random-secret
DEBUG=0
ALLOW_DEV_AUTH=0
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_TTL_SEC=86400

# Dev without VPS: cloudflared/ngrok tunnel → https://xxx.trycloudflare.com/app/
# Prod: https://your-domain/app/
MINIAPP_URL=http://localhost:8080/app/
PUBLIC_BASE_URL=http://localhost:8000

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=
TZ=Europe/Moscow

# Fernet key for field-level PII (required in prod overlay)
PII_ENCRYPTION_KEY=

# Реквизиты оператора ПДн (заказчик). Обязательны до production.
OPERATOR_LEGAL_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_PD_CONTACT=
