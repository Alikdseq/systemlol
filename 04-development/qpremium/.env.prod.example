# Production secrets — copy to server as /opt/qpremium/.env
# NEVER commit the filled file.
#
# Domain: q-premium.ru (DNS A → 83.222.17.76)
# Mini App: https://q-premium.ru/app/

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_50_CHARS
DEBUG=0
ALLOW_DEV_AUTH=0
ENABLE_DJANGO_ADMIN=0

ALLOWED_HOSTS=q-premium.ru,www.q-premium.ru,127.0.0.1,localhost,backend
ACCESS_TOKEN_TTL_SEC=86400

TELEGRAM_BOT_TOKEN=REPLACE_FROM_BOTFATHER
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://q-premium.ru
MINIAPP_URL=https://q-premium.ru/app/

# Ваш Telegram ID — станет ADMIN при первом старте (seed)
ADMIN_TELEGRAM_ID=
TZ=Europe/Moscow

POSTGRES_USER=qpremium
POSTGRES_DB=qpremium
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=REPLACE_FERNET_KEY

# Юр. реквизиты оператора ПДн (заказчик)
OPERATOR_LEGAL_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_PD_CONTACT=

# TLS terminates at Caddy; Django behind proxy
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000

THROTTLE_AUTH=20/min
THROTTLE_LOOKUP=40/min
THROTTLE_BROADCAST=3/min
