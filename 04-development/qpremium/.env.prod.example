# Production / staging template — copy to .env.prod and fill secrets.
# NEVER commit .env.prod

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_50_CHARS
DEBUG=0
ALLOW_DEV_AUTH=0
ALLOWED_HOSTS=loyalty.example.com,api.loyalty.example.com
ACCESS_TOKEN_TTL_SEC=86400

TELEGRAM_BOT_TOKEN=REPLACE_FROM_BOTFATHER
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://loyalty.example.com
MINIAPP_URL=https://loyalty.example.com/app/

ADMIN_TELEGRAM_ID=
TZ=Europe/Moscow

POSTGRES_USER=qpremium
POSTGRES_DB=qpremium
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# Optional behind TLS terminator
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000
# Django classic /admin/ — оставить 0 на prod (управление через Mini App)
ENABLE_DJANGO_ADMIN=0

THROTTLE_AUTH=20/min
THROTTLE_LOOKUP=40/min
THROTTLE_BROADCAST=3/min
